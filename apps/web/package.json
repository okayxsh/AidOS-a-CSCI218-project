{
  "name": "aidos-web",
  "private": true,
  "version": "0.0.0",
  "description": "AidOS frontend: landing page (/) and interactive dashboard (/dashboard). CSCI218 academic prototype.",
  "type": "module",
  "scripts": {
    "dev": "vite",
