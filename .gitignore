# --- Dependencies / environments ---
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]

# --- Secrets ---
.env
.env.*
!.env.example

# --- Build output ---
apps/web/dist/
*.tsbuildinfo
*.egg-info/
build/

# --- Tool caches ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
