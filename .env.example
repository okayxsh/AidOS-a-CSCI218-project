# Copy to .env (never commit .env). No secrets are needed for AidOS.

# Frontend (read by Vite from the repo root): base URL of the FastAPI backend.
VITE_API_BASE_URL=http://localhost:8000

# Backend: comma-separated origins allowed by CORS (the Vite dev server by default).
AIDOS_CORS_ORIGINS=http://localhost:5173
